# Server Configuration
PORT=4100

# NHSO Token URL (SRM Portal)
NHSO_TOKEN_URL=https://srmportal.nhso.go.th/api/scard/access-token

# Active Refresh Token
NHSO_REFRESH_TOKEN=your_refresh_token_here

# Cached Access Token (Auto-managed)
NHSO_ACCESS_TOKEN=

# API 1: Right Search (SRM)
NHSO_RIGHT_SEARCH_URL=https://srm.nhso.go.th/api/ucws/v1/right-search

# API 2: Authencode History
NHSO_AUTHEN_HISTORY_URL=https://authenservice.nhso.go.th/authencode/api/authencode-history
AUTHEN_COOKIE=SESSION=your_session; NSXLB...=...; cookiesession1=...

# HOSxP Database Connection (Read-Only)
HOS_DB_HOST=10.10.10.43
HOS_DB_PORT=3306
HOS_DB_USER=computercenter
HOS_DB_PASSWORD="Comcenter#10677"
HOS_DB_NAME=hos

# D-Flow Database Connection
DFLOW_DB_HOST=10.10.10.17
DFLOW_DB_PORT=3306
DFLOW_DB_USER=d-flow
DFLOW_DB_PASSWORD="d-Flow#106789"
DFLOW_DB_NAME="d-flow"
# Agent & Security Configuration
AGENT_SECRET=nhso-agent-secret-10677-rbh
ALLOWED_SUBNETS=10.,192.168.,172.16.,127.0.0.1,::1
JWT_SECRET=nhso-authen-jwt-secret-key-rbh-10677
